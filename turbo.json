{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DESKTOP_BUILD", "NEXT_PUBLIC_API_BASE_URL", "API_ORIGIN"],
      "outputs": [".next/**", "dist/**", "out/**", "!.next/cache/**"]
    },
    "desktop#build": {
      "dependsOn": ["^build", "web#build"],
      "cache": false,
      "env": ["DESKTOP_BUILD", "NEXT_PUBLIC_API_BASE_URL", "API_ORIGIN"],
      "outputs": [".next/**", "dist/**", "out/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

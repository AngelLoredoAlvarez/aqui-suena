{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "PAGES_PROJECT",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "ANDROID_AVD",
    "INFISICAL_RUN",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_JWKS_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_ENDPOINT",
    "CF_WORKERS_AI_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_D1_TOKEN",
    "CLOUDFLARE_DATABASE_ID",
    "ADMIN_TOKEN",
    "RESEND_API_KEY",
    "ALLOWED_ORIGINS",
    "API_ORIGIN",
    "EXPO_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_STREAM_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL",
    "HOST",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "STATIC_EXPORT",
        "NEXT_PUBLIC_API_BASE_URL",
        "API_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_URL"
      ],
      "outputs": [".next/**", "dist/**", "out/**", "!.next/cache/**"]
    },
    "desktop#build": {
      "dependsOn": ["^build", "web#build"],
      "cache": false,
      "env": [
        "STATIC_EXPORT",
        "NEXT_PUBLIC_API_BASE_URL",
        "API_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_URL"
      ],
      "outputs": [".next/**", "dist/**", "out/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# @auditIgnoreKeys(ANDROID_HOME,ANDROID_SDK_ROOT,INFISICAL_RUN)
# ----------

# ----------------------------------------------------------------------------
# Secrets (sensitive) - values come from Infisical via `infisical run`.
# ----------------------------------------------------------------------------

# @sensitive @optional @auditIgnore
DATABASE_URL=

# ----------------------------------------------------------------------------
# API server (packages/api)
# ----------------------------------------------------------------------------

# @type=port @auditIgnore
PORT=3001

# @auditIgnore
HOST=

# @auditIgnore
ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost,https://aqui-suena-web.pages.dev

# ----------------------------------------------------------------------------
# Web (Next.js)
# ----------------------------------------------------------------------------

# @auditIgnore
API_ORIGIN=http://localhost:3001

# @auditIgnore
NEXT_PUBLIC_API_BASE_URL=

# @auditIgnore
STATIC_EXPORT=

# @auditIgnore
PAGES_PROJECT=aqui-suena-web

# ----------------------------------------------------------------------------
# Mobile (Expo)
# ----------------------------------------------------------------------------

# @auditIgnore
EXPO_PUBLIC_API_BASE_URL=

# @auditIgnore
EXPO_PUBLIC_STREAM_BASE_URL=

# ----------------------------------------------------------------------------
# Tooling / CI
# ----------------------------------------------------------------------------

# @type=port @auditIgnore
E2E_PORT=3100

# @type=boolean @auditIgnore
CI=false

# ----------------------------------------------------------------------------
# Infisical (optional, for direct fetching via @varlock/infisical-plugin)
# Uncomment and fill to fetch secrets directly from Varlock instead of
# `infisical run`. See: https://varlock.dev/plugins/infisical
# Plugin: @varlock/infisical-plugin
# initInfisical(projectId=your-project-id, environment=dev, clientId=..., clientSecret=...)
# Type for client id: infisicalClientId
# Type for client secret: infisicalClientSecret (sensitive, internal)
# Example: DATABASE_URL=infisical()

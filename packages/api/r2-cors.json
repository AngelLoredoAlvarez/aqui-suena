{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://aqui-suena-web-staging.pages.dev",
          "tauri://localhost",
          "http://tauri.localhost"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}

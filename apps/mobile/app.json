{
  "expo": {
    "name": "Aquí Suena",
    "slug": "aqui-suena",
    "version": "0.0.0",
    "scheme": "aqui-suena",
    "android": {
      "package": "com.seventeenlabs.aquisuena",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",

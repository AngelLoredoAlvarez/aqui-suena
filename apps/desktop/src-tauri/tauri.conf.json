{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aquí Suena",
  "version": "0.0.0",
  "identifier": "com.seventeenlabs.aquisuena",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --dir ../.. dev:web",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Aquí Suena",
        "width": 480,
        "height": 860,
        "minWidth": 440,
        "minHeight": 620,
        "maximized": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

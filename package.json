{
  "name": "aqui-suena",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test -- --run",
    "lint": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter web dev",
    "dev:native": "pnpm --filter native start",
    "dev:native:android": "pnpm --filter native start -- --android",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write"
    ]
  }
}

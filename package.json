{
  "name": "aqui-suena",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "turbo run build",
    "build:desktop:web": "node scripts/build-desktop-web.mjs",
    "deploy:web": "node scripts/deploy-web-pages.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test scripts/check-singletons.test.mjs && turbo run test -- --run",
    "lint": "biome check --write .",
    "gitleaks:scan": "gitleaks git --config .gitleaks.toml",
    "gitleaks:dir": "gitleaks dir . --config .gitleaks.toml",
    "typecheck": "turbo run typecheck",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:singletons": "node scripts/check-singletons.mjs",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @aqui-suena/api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:lan": "node scripts/dev.mjs --mobile-only",
    "dev:mobile:build": "pnpm --filter mobile android",
    "prepare": "husky",
    "build:mobile:staging": "node scripts/build-mobile-staging.mjs",
    "varlock:load": "varlock load",
    "varlock:audit": "varlock audit",
    "varlock:codegen": "varlock codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@infisical/cli": "^0.44.6",
    "@swc/core": "1.16.18",
    "@varlock/infisical-plugin": "^2.1.3",
    "dependency-cruiser": "18.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "varlock": "^1.23.0",
    "wrangler": "4.151.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write"
    ]
  }
}
